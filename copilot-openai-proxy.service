[Unit]
Description=Copilot OpenAI Proxy Server
Documentation=https://github.com/copilot-openai-proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=%WORKING_DIR%
ExecStart=%NODE_PATH% %WORKING_DIR%/dist/index.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=copilot-proxy

# Environment
Environment=NODE_ENV=production
Environment=PORT=8066
Environment=ACCESS_TOKEN=lfdou,openaiapi

[Install]
WantedBy=default.target
